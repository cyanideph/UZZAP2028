# UZZAP2028 staging template
# Do not commit real staging secrets.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App
APP_ENV=staging

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Stripe test mode
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_MERCHANT_IDENTIFIER=
EXPO_PUBLIC_URL_SCHEME=uzzap2028-staging

# Server-only secrets (store in EAS/Supabase secret storage)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# OPENAI_API_KEY=
# RESEND_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Monitoring
EXPO_PUBLIC_SENTRY_DSN=

# OAuth (only when providers are enabled)
# APPLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
